@model IEnumerable<DSWI_T1_Grupo7.Models.Producto>
@{ ViewData["Title"] = "Productos"; }
<h1>Productos</h1>
<p><a asp-action="Crear" class="btn btn-primary">Nuevo producto</a></p>
<table class="table table-striped">
    <thead><tr><th>ID</th><th>Nombre</th><th>Categoría</th><th></th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.ProductoId</td><td>@item.Nombre</td><td>@item.Categoria</td>
            <td><a asp-action="Editar" asp-route-id="@item.ProductoId" class="btn btn-sm btn-warning">Editar</a></td>
        </tr>
    }
    </tbody>
</table>
